+        expect(pending.state, GuidedSaveState.failed);
+        expect(h.adapter.writes, isEmpty);
+        await pending.retry();
+        expect(pending.conflict, isTrue);
+        expect(h.adapter.writes, isEmpty);
+      });
+    }
