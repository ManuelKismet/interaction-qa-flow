+        )
+    )
+    for user_id, organisation_id in existing_admins:
+        if isinstance(user_id, str):
+            user_id = UUID(user_id)
+        if isinstance(organisation_id, str):
+            organisation_id = UUID(organisation_id)
+        connection.execute(
